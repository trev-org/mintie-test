=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.SSLError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">SSLError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.SSLError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>An SSL error occurred.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.Timeout\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">Timeout</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.Timeout\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The request timed out.</p>\n<p>Catching this error will catch both\n<a class=\"reference internal\" href=\"#requests.exceptions.ConnectTimeout\" title=\"requests.exceptions.ConnectTimeout\"><code class=\"xref py py-exc docutils literal notranslate\"><span class=\"pre\">ConnectTimeout</span></code></a> and\n<a class=\"reference internal\" href=\"#requests.exceptions.ReadTimeout\" title=\"requests.exceptions.ReadTimeout\"><code class=\"xref py py-exc docutils literal notranslate\"><span class=\"pre\">ReadTimeout</span></code></a> errors.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.ConnectTimeout\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ConnectTimeout</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.ConnectTimeout\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The request timed out while trying to connect to the remote server.</p>\n<p>Requests that produced this error are safe to retry.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.ReadTimeout\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ReadTimeout</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.ReadTimeout\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The server did not send any data in the allotted amount of time.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.URLRequired\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">URLRequired</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.URLRequired\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>A valid URL is required to make a request.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.TooManyRedirects\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">TooManyRedirects</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.TooManyRedirects\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Too many redirects.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.MissingSchema\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">MissingSchema</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.MissingSchema\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The URL scheme (e.g. http or https) is missing.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.InvalidSchema\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">InvalidSchema</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.InvalidSchema\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The URL scheme provided is either invalid or unsupported.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.InvalidURL\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">InvalidURL</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.InvalidURL\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The URL provided was somehow invalid.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.InvalidHeader\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">InvalidHeader</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.InvalidHeader\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The header value provided was somehow invalid.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.InvalidProxyURL\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">InvalidProxyURL</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.InvalidProxyURL\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The proxy URL provided is invalid.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.ChunkedEncodingError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ChunkedEncodingError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.ChunkedEncodingError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The server declared chunked encoding but sent an invalid chunk.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.ContentDecodingError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ContentDecodingError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.ContentDecodingError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Failed to decode response content.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.StreamConsumedError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">StreamConsumedError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.StreamConsumedError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The content for this response was already consumed.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.RetryError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">RetryError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.RetryError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Custom retries logic failed</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.UnrewindableBodyError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">UnrewindableBodyError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#requests.exceptions.UnrewindableBodyError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Requests encountered an error when trying to rewind a body.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.RequestsWarning\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><span class=\"sig-name descname\"><span class=\"pre\">RequestsWarning</span></span><a class=\"headerlink\" href=\"#requests.exceptions.RequestsWarning\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Base warning for Requests.</p>\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"requests.exceptions.FileModeWarning\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">requests.exceptions.</span></span><s