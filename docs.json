  "api": {
    "playground": {
      "display": "auth"
    },
    "examples": {
      "prefill": true
    }
  },
  "colors": {
    "primary": "#0C8C5E",
    "light": "#0C8C5E",
    "dark": "#0C8C5E"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "add-mcp",
      "download-spec",
      "download-pdf"
    ]
  },
  "favicon": "/favicon.svg",
