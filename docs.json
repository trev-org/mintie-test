{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Mintie SSO",
  "description": "Enterprise SSO, SCIM, and identity for Mintie",
  "public": true,
  "colors": {
    "primary": "#0C8C5E",
    "light": "#0C8C5E",
    "dark": "#0C8C5E"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "add-mcp",
      "download-spec",
      "download-pdf"
    ]
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get started",
                "public": true,
                "pages": ["index", "introduction", "quickstart"]
              },
              {
                "group": "Concepts",
                "public": true,
                "pages": [
                  "concepts/how-sso-works",
                  "concepts/identity-linking",
                  "concepts/sessions",
                  "concepts/feature-flags"
                ]
              },
              {
                "group": "Set up a provider",
                "public": true,
                "pages": [
                  "setup/sign-in-experience",
                  "setup/enable-sso",
                  "setup/okta",
                  "setup/google-workspace",
                  "setup/generic-saml"
                ]
              },
              {
                "group": "User provisioning",
                "public": true,
                "pages": [
                  "provisioning/overview",
                  "provisioning/scim",
                  "provisioning/jit"
                ]
              },
              {
                "group": "API & integrations",
                "public": true,
                "pages": ["api-and-keys/api-keys"]
              },
              {
                "group": "Security",
                "public": true,
                "pages": ["security/mfa", "security/audit-logs"]
              },
              {
                "group": "Migration",
                "public": true,
                "pages": [
                  "migration/timeline",
                  "migration/user-comms",
                  "migration/faq"
                ]
              }
            ]
          },
          {
            "tab": "Operations",
            "groups": [
              {
